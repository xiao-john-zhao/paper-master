{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "paper-master",
  "version": "0.3.1",
  "identifier": "app.papermaster.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "paper-master",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Private local research paper manager",
    "longDescription": "paper-master manages and analyzes local research papers with a local LM Studio model.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
